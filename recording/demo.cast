[32.722, "o", "\u001b[1m\u001b[31m  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\r\n"]
[32.722, "o", "\u001b[1m\u001b[31m  \u2502 CONTAINED: THE SANDBOX DENIED BOTH REACHES                            \u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2502\u001b[0m\u001b[31m   it passed the gate (complete, signed, trusted) and the agent ran it \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2502\u001b[0m\u001b[31m   file read   ../vault/placeholder.txt  -> DENIED                     \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2502\u001b[0m\u001b[31m   network     1.1.1.1:443 (raw socket)  -> DENIED                     \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n"]
[34.722, "o", "\u001b[32m  \u2714\u001b[0m \u001b[2mas expected: the full gate passed, then the sandbox denied the file read and the network connect (exit 9; RESULT file=denied net=denied status=contained)\u001b[0m\r\n"]
[37.724, "o", "\u001b[2m# The control experiment: the SAME signed helper, run directly with python3: no nono, no sandbox.\u001b[0m\r\n\u001b[2m# If it now reads the file, the denial above came from the sandbox, not from a missing file or a bug.\u001b[0m\r\n\u001b[2m# (NONO_DEMO_NONET=1 skips its network reach, so the laptop makes no real outbound connection.)\u001b[0m\r\n"]
[37.724, "o", "\u001b[1m\u001b[36m$ env NONO_DEMO_NONET=1 python3 .claude/skills/changelog-publish/scripts/publish.py\u001b[0m\r\n"]

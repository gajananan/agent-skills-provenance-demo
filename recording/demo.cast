[47.279, "o", "\r\n\u001b[1m\u001b[31m  \u2502\u001b[0m\u001b[31m   not run: nono run --allow-cwd -- echo (should not run)         \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2502\u001b[0m\u001b[31m   Nothing ran: no agent, no skill code.                          \u001b[1m\u2502\u001b[0m\r\n\u001b[1m\u001b[31m  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n"]
[49.281, "o", "\u001b[32m  \u2714\u001b[0m \u001b[2mas expected: the gate refused the addition (at the completeness layer; no run marker)\u001b[0m\r\n"]
[49.284, "o", "\u001b[32m  \u2714\u001b[0m \u001b[2mreason: a file that is not in the signed inventory\u001b[0m\r\n"]
[49.285, "o", "\u001b[2m  (restored to a clean state)\u001b[0m\r\n"]
[49.286, "o", "\r\n\u001b[1m\u001b[34m============================================================\u001b[0m\r\n\u001b[1m\u001b[34m  Done\u001b[0m\u001b[1m \u00b7 one launch gate (completeness + signatures) + process sandbox\u001b[0m\r\n\u001b[1m\u001b[34m============================================================\u001b[0m\r\n\r\n"]
[49.286, "o", "\u001b[32mEvery check behaved as expected.\u001b[0m  (deterministic stand-in; the same beats also run with the real agent)\r\n"]
